{
  "manifest_version": 3,
  "name": "Property Search Assistant",
  "version": "0.1.0",
  "description": "Compare property listings from selected websites.",
  "minimum_chrome_version": "114",
  "permissions": ["sidePanel", "storage", "tabs"],
  "host_permissions": [
    "<all_urls>",
    "https://99acres.com/*",
    "https://www.99acres.com/*",
    "https://magicbricks.com/*",
    "https://www.magicbricks.com/*",
    "https://housing.com/*",
    "https://www.housing.com/*",
    "https://nobroker.in/*",
    "https://www.nobroker.in/*",
    "https://squareyards.com/*",
    "https://www.squareyards.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Property Search"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "content_scripts": [
    {
      "matches": ["https://99acres.com/*", "https://www.99acres.com/*"],
      "js": ["content-scripts/listing-proof.js", "content-scripts/99acres.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://magicbricks.com/*", "https://www.magicbricks.com/*"],
      "js": ["content-scripts/listing-proof.js", "content-scripts/magicbricks.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://housing.com/*", "https://www.housing.com/*"],
      "js": ["content-scripts/listing-proof.js", "content-scripts/housing.js"],
      "run_at": "document_idle"
    }
  ]
}
